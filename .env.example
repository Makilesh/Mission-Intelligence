# Copy to .env and adjust. Every value here has a working default: the system runs
# end-to-end with this file absent, offline, and with no API keys.

# ---------------------------------------------------------------------------
# LLM reasoning layer
# ---------------------------------------------------------------------------
# deterministic | anthropic | openai
# "deterministic" is a template synthesiser: no network, no variance, and structurally
# incapable of inventing evidence. It is what the evaluation harness runs against so that
# retrieval and coverage metrics cannot be contaminated by model drift.
LLM_PROVIDER=deterministic

# Used only when LLM_PROVIDER is anthropic or openai.
LLM_MODEL=claude-opus-5
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# ---------------------------------------------------------------------------
# Retrieval
# ---------------------------------------------------------------------------
# auto | sentence_transformers | hashing
#   auto  -> try sentence-transformers, fall back to deterministic TF-IDF+SVD
DENSE_BACKEND=auto
DENSE_MODEL=all-MiniLM-L6-v2

# Keep HuggingFace fully offline (the model is expected to be in the local cache).
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
TOKENIZERS_PARALLELISM=false

# ---------------------------------------------------------------------------
# Service
# ---------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
UI_PORT=8501
